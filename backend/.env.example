# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins (Next.js app).
# Must include the scheme (https://) and no trailing slash — must match the
# browser's Origin header exactly, or the pattern below.
# `*` acts as a wildcard, which is useful for Vercel: its PRODUCTION domain
# (Project > Settings > Domains) is stable, but every preview deployment gets
# a new random-hash URL like https://my-app-<hash>-<team>.vercel.app — use a
# wildcard pattern to cover those too, e.g.:
#   FRONTEND_ORIGIN=https://my-app.vercel.app,https://my-app-*-my-team.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# --- LLM (generation) ---
# Using Groq's OpenAI-compatible API (free tier, fast Llama models).
# Get a key at https://console.groq.com/keys
# Swap OPENAI_BASE_URL/OPENAI_MODEL to use OpenAI or another compatible
# provider instead if needed.
OPENAI_API_KEY=gsk-your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# --- Pinecone (vector DB) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=rag-boilerplate
# Namespace lets you separate multiple datasets/projects inside one index
PINECONE_NAMESPACE=default

# --- Embeddings ---
# Local, quantized MiniLM model (no API key, no per-call cost, ~384 dims).
# Runs in-process via @xenova/transformers and fits Render's free tier.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Retrieval / prompting ---
TOP_K=4
